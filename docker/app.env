CI_ENVIRONMENT=development

# Pasiekiama: localhost:8080 arba <HOST_IP>:8080 (VU tinklą)
app.baseURL=${APP_BASE_URL:-http://localhost:8080/}
app.defaultLocale=lt
app.appTimezone=Europe/Vilnius
app.forceGlobalSecureRequests=false
app.CSPEnabled=false

database.default.hostname=db
database.default.database=korepetitoriai
database.default.username=ciuser
database.default.password=cipassword
database.default.DBDriver=MySQLi
database.default.port=3306
database.default.charset=utf8mb4
database.default.DBCollat=utf8mb4_general_ci

logger.threshold=4
session.driver=CodeIgniter\Session\Handlers\FileHandler
session.savePath=null
security.csrfProtection=session
